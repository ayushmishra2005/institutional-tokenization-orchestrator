# Local development configuration. Copy to .env before running the stack.
# Every value here is a well-known local development value with no real-world authority.

NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgres://ito:ito@127.0.0.1:55432/ito
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:56379
QUEUE_PREFIX=ito

EVM_RPC_URL=http://127.0.0.1:58545
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=2
EVM_RECEIPT_TIMEOUT_MS=60000
MINT_DEADLINE_SECONDS=900
TRANSACTION_STUCK_AFTER_MS=60000
TRANSACTION_MAX_REPLACEMENTS=3
TRANSACTION_FEE_BUMP_PERCENT=25
SIGNER_REQUEST_TIMEOUT_MS=300000

JWT_SECRET=local-development-jwt-secret-change-me
JWT_ISSUER=ito-local
JWT_AUDIENCE=ito-api

# DEVELOPMENT ONLY.
# This is Anvil's first well-known account from the standard public test mnemonic
# ("test test test ... junk"). It controls nothing of value and must never be reused.
LOCAL_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
LOCAL_SIGNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
RECOVERY_SWEEP_INTERVAL_MS=5000
RECOVERY_STALE_AFTER_MS=15000

METRICS_ENABLED=true

# Optional second chain profile. Leave unset to run against Anvil only; nothing in the
# test suite reads these. Supply the deploying key through the environment, not this file.
# TESTNET_RPC_URL=
# TESTNET_CHAIN_ID=
# TESTNET_CONFIRMATIONS=3
